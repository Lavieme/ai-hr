# 本地开发：先启动 PostgreSQL + MinIO，再运行 pnpm dev。
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/ai_hr
APP_PASSWORD=zhiheng-demo
# 正式部署请替换为随机值，例如 openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:3000
# 本地 HTTP 使用 false；cluster HTTPS 部署改为 true。
COOKIE_SECURE=false
# 服务端 OpenAI 兼容接口。也兼容 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
OSS_ACCESS_KEY_ID=minioadmin
OSS_SECRET_ACCESS_KEY=minioadmin123
OSS_BUCKET=ai-hr
OSS_PATH_PREFIX=ai-hr
OSS_REGION=us-east-1
OSS_ENDPOINT=http://localhost:9000
OSS_PUBLIC_ENDPOINT=http://localhost:9000
OSS_FORCE_PATH_STYLE=true
OSS_PRESIGN_EXPIRES_IN=300
# Compose 中 PG 和 MinIO 本地端口可覆盖
APP_PORT=3000
PG_PORT=5438
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
